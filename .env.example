# Copy this file to .env and fill in what you need.

# --- Answer generation: anthropic | ollama | extractive (offline, no model) ---
PP_LLM=anthropic
ANTHROPIC_API_KEY=your-key-here
PP_ANTHROPIC_MODEL=claude-haiku-5-5

# Free local alternative: install Ollama, run `ollama pull llama3.1`, then set PP_LLM=ollama
PP_OLLAMA_URL=http://localhost:11434
PP_OLLAMA_MODEL=llama3.1

# --- Embeddings: sentence-transformers (real) | hash (offline tests only) ---
PP_EMBED_BACKEND=sentence-transformers
PP_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking (in words) ---
PP_CHUNK_SIZE=300
PP_CHUNK_OVERLAP=50

# --- Retrieval ---
PP_TOP_K=5
PP_FETCH_K=20
PP_RERANK=false
PP_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Refuse without calling the LLM if the best match scores below this (0 = off).
PP_MIN_SCORE=0.0

# --- Topic research (python -m paperpilot.research "your topic") ---
# Optional free key from https://www.semanticscholar.org/product/api (higher rate limit)
PP_S2_API_KEY=
# Optional: your email, sent to OpenAlex/arXiv as a polite contact (faster OpenAlex pool)
PP_CONTACT_EMAIL=
# Results requested per search query and per source
PP_RESEARCH_PER_QUERY=25
# Ranking: score = SIM_WEIGHT * similarity(topic, title+abstract) + CITE_WEIGHT * log(1 + citations)
PP_RANK_SIM_WEIGHT=1.0
PP_RANK_CITE_WEIGHT=0.03
# Seconds to wait between PDF downloads
PP_DOWNLOAD_DELAY=1.0

# --- Paths ---
PP_PAPERS_DIR=data/papers
PP_DB_DIR=data/chroma
PP_EVAL_DIR=eval
PP_RESEARCH_DIR=data/research
